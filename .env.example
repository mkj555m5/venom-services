# ============ Venom Services — Environment Variables ============
# انسخ هذا الملف إلى .env وعدّل القيم قبل التشغيل المحلي
# على Railway: أضف المتغيرات من لوحة التحكم (Variables)

# --- قاعدة البيانات ---
# Railway: postgresql://... (يُنشأ تلقائياً عند إضافة خدمة PostgreSQL)
# محلي: ملف SQLite
DATABASE_URL="file:/home/z/venom_data/venom.db"

# --- الأمان ---
# مفتاح توقيع JWT — غيّره لقيمة عشوائية طويلة في الإنتاج!
JWT_SECRET="venom-services-dev-secret-change-me-in-production"
# توكن داخلي بين الخدمات المصغرة (hosting/chat ↔ main)
INTERNAL_TOKEN="venom-internal"

# --- حساب المالك (يُزرع تلقائياً عند أول إقلاع — ثابت لا يُحذف) ---
OWNER_USERNAME="RTQ_67"
OWNER_PASSWORD="@ROblox2011"

# --- الخدمات المصغرة (تولد داخلياً — لا تعدّل إلا لو فصلتها) ---
HOSTING_SERVICE_URL="http://127.0.0.1:3031"
CHAT_SERVICE_PORT="3003"
HOSTING_DATA_DIR=""
MAIN_APP_URL=""

# --- Venom Leak Check (اختياري — بدون مفتاح تعمل كلمات المرور فقط عبر k-anonymity) ---
HIBP_API_KEY=""

# --- Venom MEGA (رابط Cloudflare Worker بعد نشر services/mega/worker.js) ---
MEGA_INDEX_URL=""
CLOUDFLARE_WORKER_URL=""

# --- VenomXNG (اختياري — محرك SearXNG خارجي، بدونه يستخدم DuckDuckGo+Wikipedia) ---
VENOMXNG_URL=""

# --- البريد (اختياري — لإرسال رمز استعادة كلمة المرور، بدون SMTP يظهر الرمز في الواجهة) ---
SMTP_URL=""
SMTP_FROM="Venom Services <no-reply@venom.services>"

# --- مولد الشعارات بالذكاء الاصطناعي (اختياري — بدون مفتاح يعمل المولد SVG المدمج) ---
LOGO_GENERATOR_API_KEY=""
